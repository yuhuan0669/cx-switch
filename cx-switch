CX_VERSION="1.1.2"

_get_account_details() {
  local auth_file="$1"
  [[ -f "$auth_file" ]] || return 1

  # 1. 优先使用 Python3 解析 JWT 与 JSON (最精准、兼容性最好)
  if command -v python3 >/dev/null 2>&1; then
    python3 -c '
import json, base64, sys

try:
    with open(sys.argv[1], "r", encoding="utf-8") as f:
        data = json.load(f)
    
    email = data.get("email") or ""
    plan = ""

    id_token = data.get("tokens", {}).get("id_token") or data.get("id_token")
    if id_token and isinstance(id_token, str):
        parts = id_token.split(".")
        if len(parts) >= 2:
            p = parts[1]
            p += "=" * (-len(p) % 4)
            claims = json.loads(base64.urlsafe_b64decode(p).decode("utf-8", errors="ignore"))
            email = claims.get("email") or claims.get("preferred_username") or email
            auth_info = claims.get("https://api.openai.com/auth", {})
            if isinstance(auth_info, dict):
                plan = auth_info.get("chatgpt_plan_type") or ""

    if not email and data.get("OPENAI_API_KEY"):
        k = data["OPENAI_API_KEY"]
        email = f"API-Key ({k[:7]}...{k[-4:]})" if len(k) > 12 else "API-Key"

    parts_out = []
    if email:
        parts_out.append(email)
    if plan:
        parts_out.append(f"[{plan}]")

    if parts_out:
        print(" ".join(parts_out))
        sys.exit(0)
except Exception:
    pass
sys.exit(1)
' "$auth_file" 2>/dev/null && return 0
  fi

  # 2. 纯 Shell 回退解析 (无 Python 环境时，利用 base64 与 grep 提取 email)
  local id_token
  id_token=$(grep -oE '"id_token"[[:space:]]*:[[:space:]]*"[^"]+"' "$auth_file" 2>/dev/null | head -1 | sed 's/.*"id_token"[[:space:]]*:[[:space:]]*"//; s/".*//')
  if [[ -n "$id_token" ]]; then
    local payload
    payload=$(echo "$id_token" | cut -d. -f2 | tr '_-' '/+')
    local pad=$(( (4 - ${#payload} % 4) % 4 ))
    [[ $pad -eq 1 ]] && payload="${payload}="
    [[ $pad -eq 2 ]] && payload="${payload}=="
    [[ $pad -eq 3 ]] && payload="${payload}==="
    local decoded
    decoded=$(echo "$payload" | base64 -d 2>/dev/null || echo "$payload" | base64 -D 2>/dev/null)
    local email
    email=$(echo "$decoded" | grep -oE '"email"[[:space:]]*:[[:space:]]*"[^"]+"' | head -1 | sed 's/.*"email"[[:space:]]*:[[:space:]]*"//; s/".*//')
    if [[ -n "$email" ]]; then
      echo "$email"
      return 0
    fi
  fi

  return 1
}

cx-switch() {
  local dir="${CODEX_HOME:-$HOME/.codex}"
  local current_tag="$dir/.current_acc"
  local auth="$dir/auth.json"
  local force=0
  local args=()
  for arg in "$@"; do
    if [[ "$arg" == "-f" || "$arg" == "--force" ]]; then
      force=1
    else
      args+=("$arg")
    fi
  done

  local action="${args[0]}"

  # 1. 确保配置目录存在
  if [[ ! -d "$dir" ]]; then
    mkdir -p "$dir" 2>/dev/null || {
      echo "错误: 无法创建或访问 Codex 配置目录: $dir"
      return 1
    }
  fi

  local prev=""
  if [[ -f "$current_tag" ]]; then
    read -r prev < "$current_tag" 2>/dev/null
  fi

  # 2. 版本查看 (-v, --version)
  if [[ "$action" == "-v" || "$action" == "--version" ]]; then
    echo "cx-switch v$CX_VERSION"
    return 0
  fi

  # 3. 帮助手册 (-h, --help, help)
  if [[ "$action" == "-h" || "$action" == "--help" || "$action" == "help" ]]; then
    echo "用法:"
    echo "  cx-switch                   查看当前登录与已保存账号"
    echo "  cx-switch <账号名>          切换到指定账号 (若已在当前账号则自动同步刷新凭据)"
    echo "  cx-switch save <账号名>     将当前活跃登录凭据另存/绑定为指定账号"
    echo "  cx-switch new               安全封存当前账号并清空凭据，以便启动 Codex 登录新账号"
    echo "  cx-switch rm <账号名>       删除指定的账号备份"
    echo "  cx-switch -f, --force       强制切换 (跳过运行中的 Codex 进程检查)"
    echo "  cx-switch -h, --help        显示帮助信息"
    echo "  cx-switch -v, --version     显示版本信息"
    return 0
  fi

  # 4. 默认查看状态（无参数、status、ls、list）
  if [[ -z "$action" || "$action" == "status" || "$action" == "ls" || "$action" == "list" ]]; then
    local active_details=""
    if [[ -f "$auth" ]]; then
      active_details=$(_get_account_details "$auth")
    fi

    echo "当前登录: ${active_details:-未登录}"
    echo "已保存账号:"

    local found=0
    local restore_nullglob=""
    if [[ -n "$ZSH_VERSION" ]]; then
      setopt local_options null_glob
    elif [[ -n "$BASH_VERSION" ]]; then
      shopt -q nullglob || restore_nullglob="yes"
      shopt -s nullglob
    fi
    local files=("$dir"/auth.*.json)
    [[ -n "$restore_nullglob" ]] && shopt -u nullglob

    if [[ ${#files[@]} -eq 0 ]]; then
      echo "  (暂无保存)"
      return 0
    fi

    # 动态计算别名列宽（默认至少 14 字符）
    local max_w=14
    for f in "${files[@]}"; do
      [[ -e "$f" ]] || continue
      local n="${f#$dir/auth.}"
      n="${n%.json}"
      [[ ${#n} -gt $max_w ]] && max_w=${#n}
    done

    for f in "${files[@]}"; do
      [[ -e "$f" ]] || continue
      local acc_name="${f#$dir/auth.}"
      acc_name="${acc_name%.json}"
      
      local acc_details=""
      acc_details=$(_get_account_details "$f")

      local marker=" "
      [[ "$acc_name" == "$prev" ]] && marker="*"

      printf "  %s %-${max_w}s %s\n" "$marker" "$acc_name" "$acc_details"
      found=1
    done

    [[ $found -eq 0 ]] && echo "  (暂无保存)"
    return 0
  fi

  # 5. 子命令：清空当前凭据准备登录新账号 (cx-switch new)
  if [[ "$action" == "new" ]]; then
    if pgrep -ix "codex" >/dev/null 2>&1; then
      if [[ $force -eq 1 ]]; then
        echo "警告: 检测到 Codex 正在运行，已通过 --force 强制执行"
      else
        echo "错误: 检测到 Codex 正在运行！请先彻底关闭 Codex (CLI / Desktop) 后再操作 (或使用 -f / --force 强制执行)。"
        return 1
      fi
    fi

    # 若当前有活跃有效凭据，先安全归档
    if [[ -n "$prev" && -f "$auth" ]] && grep -qE '"(access_token|refresh_token|api_key|session_token)"' "$auth" 2>/dev/null; then
      if (umask 077 && cp "$auth" "$dir/auth.${prev}.json.tmp" && mv "$dir/auth.${prev}.json.tmp" "$dir/auth.${prev}.json"); then
        local prev_info
        prev_info=$(_get_account_details "$dir/auth.${prev}.json")
        echo "已自动保存 [$prev]${prev_info:+ ($prev_info)} 的最新凭据备份"
      fi
    fi

    rm -f "$auth" "$current_tag"
    echo "已成功清除当前登录态槽位。"
    echo "提示: 现在可以启动 Codex 登录新账号，完成登录后执行: cx-switch save <新账号名>"
    return 0
  fi

  # 6. 子命令：显式绑定/另存当前凭据 (cx-switch save <name>)
  if [[ "$action" == "save" ]]; then
    local save_name="${args[1]}"
    if [[ -z "$save_name" ]]; then
      echo "错误: 请指定要保存的账号名称。例如: cx-switch save work"
      return 1
    fi
    if [[ ! "$save_name" =~ ^[a-zA-Z0-9_-]+$ ]] || [[ "$save_name" =~ ^(tmp|save|new|rm|delete|ls|list|status|help)$ ]]; then
      echo "错误: 账号名只能包含英文字母、数字、下划线和连字符，且不能使用系统保留字"
      return 1
    fi

    if [[ ! -f "$auth" ]] || ! grep -qE '"(access_token|refresh_token|api_key|session_token)"' "$auth" 2>/dev/null; then
      echo "错误: 当前 auth.json 不存在或未处于有效登录状态，无法保存"
      return 1
    fi

    if ! (umask 077 && cp "$auth" "$dir/auth.${save_name}.json.tmp" && mv "$dir/auth.${save_name}.json.tmp" "$dir/auth.${save_name}.json"); then
      echo "错误: 写入凭据备份失败"
      return 1
    fi

    (umask 077 && echo "$save_name" > "$current_tag.tmp" && mv "$current_tag.tmp" "$current_tag")
    
    local saved_details
    saved_details=$(_get_account_details "$dir/auth.${save_name}.json")
    echo "已将当前登录凭据保存为 [$save_name]${saved_details:+ ($saved_details)}"
    return 0
  fi

  # 7. 子命令：删除账号备份 (cx-switch rm <name> / cx-switch delete <name>)
  if [[ "$action" == "rm" || "$action" == "delete" ]]; then
    local del_name="${args[1]}"
    if [[ -z "$del_name" ]]; then
      echo "错误: 请指定要删除的账号名称。例如: cx-switch rm test_acc"
      return 1
    fi
    local del_auth="$dir/auth.${del_name}.json"
    if [[ ! -f "$del_auth" ]]; then
      echo "错误: 未找到账号 [$del_name] 的备份文件"
      return 1
    fi

    rm -f "$del_auth"
    echo "已删除账号 [$del_name] 的备份文件"
    if [[ "$del_name" == "$prev" ]]; then
      rm -f "$current_tag"
      echo "提示: 被删除的账号是当前激活账号，已重置激活状态标记"
    fi
    return 0
  fi

  # 8. 账号切换逻辑 (cx-switch <target>)
  local target="$action"

  # 校验目标账号名合法性
  if [[ ! "$target" =~ ^[a-zA-Z0-9_-]+$ ]] || [[ "$target" =~ ^(tmp|save|new|rm|delete|ls|list|status|help)$ ]]; then
    echo "错误: 账号名格式不合法或为系统保留字"
    echo "用法提示: cx-switch <账号名> 或 cx-switch --help"
    return 1
  fi

  local target_auth="$dir/auth.${target}.json"

  # 9. 原地刷新同步检查 (当前账号仅做凭据单向归档，不修改 auth.json，允许 Codex 运行中执行)
  if [[ "$target" == "$prev" ]]; then
    if [[ -f "$auth" ]] && grep -qE '"(access_token|refresh_token|api_key|session_token)"' "$auth" 2>/dev/null; then
      if (umask 077 && cp "$auth" "$target_auth.tmp" && mv "$target_auth.tmp" "$target_auth"); then
        local sync_details
        sync_details=$(_get_account_details "$target_auth")
        echo "已同步更新 [$target]${sync_details:+ ($sync_details)} 的最新凭据到本地备份"
      else
        echo "错误: 同步凭据失败"
        return 1
      fi
    else
      echo "提示: 当前已激活 [$target]，未发现需要更新的凭据"
    fi
    return 0
  fi

  # 10. 检查 Codex 进程 (仅跨账号切换才需要确保关闭 Codex，防止文件热替换冲突)
  if pgrep -ix "codex" >/dev/null 2>&1; then
    if [[ $force -eq 1 ]]; then
      echo "警告: 检测到 Codex 正在运行，已通过 --force 强制执行"
    else
      echo "错误: 检测到 Codex 正在运行！请先彻底关闭 Codex (CLI / Desktop) 后再切换账号 (或使用 -f / --force 强制执行)。"
      return 1
    fi
  fi

  # 10. 切换检查：目标账号必须预先存在（防止意外覆盖）
  if [[ ! -f "$target_auth" ]]; then
    echo "错误: 未找到账号 [$target] 的备份配置"
    echo "若要将当前登录绑定为 [$target]，请运行: cx-switch save $target"
    return 1
  fi

  # 11. 安全回存旧账号凭据（带有效性校验 + umask 077 + 原子替换）
  if [[ -n "$prev" && -f "$auth" ]]; then
    if grep -qE '"(access_token|refresh_token|api_key|session_token)"' "$auth" 2>/dev/null; then
      if ! (umask 077 && cp "$auth" "$dir/auth.${prev}.json.tmp" && mv "$dir/auth.${prev}.json.tmp" "$dir/auth.${prev}.json"); then
        echo "错误: 无法保存当前账号 [$prev] 的凭据，已中止切换"
        return 1
      fi
      local prev_info
      prev_info=$(_get_account_details "$dir/auth.${prev}.json")
      echo "已自动归档 [$prev]${prev_info:+ ($prev_info)} 的最新登录凭据"
    else
      echo "警告: 当前凭据为空或已失效，跳过对 [$prev] 备份的覆盖"
    fi
  fi

  # 12. 载入目标账号
  if ! (umask 077 && cp "$target_auth" "$auth.tmp" && mv "$auth.tmp" "$auth"); then
    echo "错误: 切换至 [$target] 失败"
    return 1
  fi

  (umask 077 && echo "$target" > "$current_tag.tmp" && mv "$current_tag.tmp" "$current_tag")
  
  local target_details
  target_details=$(_get_account_details "$auth")
  echo "已成功切换至 [$target]${target_details:+ ($target_details)}，现在可以启动 Codex 了"
}

# ------------------------------------------------------------------------------
# 兼容直接执行 (Standalone CLI) 与 Source 引入 (Shell Function)
# ------------------------------------------------------------------------------
if [[ -n "$ZSH_VERSION" ]]; then
  [[ "$ZSH_EVAL_CONTEXT" != *:file* ]] && cx-switch "$@"
elif [[ -n "$BASH_VERSION" ]]; then
  [[ "${BASH_SOURCE[0]}" == "$0" ]] && cx-switch "$@"
fi
